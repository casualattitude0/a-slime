GOOGLE_API_KEY=
# Optional alias (same key as GOOGLE_API_KEY):
# GEMINI_API_KEY=

# Gemini embedding model for ingest + Chroma queries (must match ingest; default gemini-embedding-001).
# After changing this, delete chroma_db and run python src/ingest.py again.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini chat model when OLLAMA_MODEL is unset (override if your API listing differs).
# GEMINI_MODEL=gemini-2.0-flash

# Local agent LLM (Ollama). If set, the chat model uses Ollama; pull the model first, e.g. ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL=qwen3.5:35b-a3b
# OLLAMA_BASE_URL=http://localhost:11434

# Stronger Gemini model used by the ask_reasoning_model tool (default gemini-2.5-pro).
# GEMINI_REASONING_MODEL=gemini-2.5-pro

# NVIDIA NIM / API Catalog chat (optional). Enables model_profile "nvidia" when set.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=z-ai/glm-5.1
# (catalog id from the model URL path, e.g. build.nvidia.com/z-ai/glm-5.1 )
# Self-hosted NIM only (otherwise omit):
# NVIDIA_BASE_URL=http://localhost:8000

# NVIDIA: default uses native tool-calling (ReAct off). Many catalog models reply in plain text and fail ReAct parsing → iteration loop.
# Set AGENT_NVIDIA_USE_REACT=1 only if the model reliably follows Thought/Action/Final Answer format.
# AGENT_NVIDIA_USE_REACT=0

# NVIDIA: cap ReAct LLM rounds per user message (default 5; was implicitly 10).
# AGENT_NVIDIA_MAX_ITERATIONS=5

# NVIDIA ReAct: max chat_history messages retained (Human+AI turns); omit or set 0/all/full for no trim.
# AGENT_NVIDIA_REACT_HISTORY_MSGS=16

# Google Calendar API (OAuth user token with https://www.googleapis.com/auth/calendar.events — NOT the Gemini API key).
# 401 Unauthorized = expired/revoked token or wrong credential type; run: python scripts/get_google_oauth_token.py
# Optional: install google-auth + google-auth-oauthlib and keep google_oauth_token.json — token refresh on use.
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# Calendar id from Google Calendar settings (often "primary" or an email-address calendar id).
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_TOKEN_CACHE_FILE=google_oauth_token.json
